# Gartika Platform Environment Configuration
PROJECT_NAME="Gartika Urban Intelligence"
VERSION="1.1.0"
ENVIRONMENT="development"

# Server & Network
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
DASHBOARD_PORT=3000
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"

# Default Bus Identifier
GARTIKA_BUS_ID=BUS-101

# Modes & Thresholds
DEMO_MODE=false
CONFIDENCE_THRESHOLD=0.45
FUSION_TEMPORAL_WINDOW_MS=500
SPATIAL_DEDUP_METERS=15.0

# Database (SQLite for local dev, PostgreSQL/PostGIS for production)
DATABASE_URL=sqlite:///./gartika.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gartika

# Security & Authentication (optional for local dev, enable for production)
DEVICE_AUTH_ENABLED=false
DEVICE_API_KEY="gartika_dev_device_token_secret"
JWT_SECRET="gartika_jwt_secret_change_in_production"

# Media Storage
EVIDENCE_DIR=data/evidence
VIDEOS_DIR=data/videos
DEMO_DIR=data/demo

# SSL / HTTPS Configuration (optional)
USE_HTTPS=false
SSL_CERT_PATH=cert.pem
SSL_KEY_PATH=key.pem

